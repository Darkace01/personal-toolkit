{
  "name": "personal-toolkit-extension",
  "version": "1.0.0",
  "description": "Chrome extension for GitHub themes and custom CSS snippets",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome lint ./src ./tests",
    "format": "biome format --write ./src ./tests",
    "check": "biome check --write ./src ./tests",
    "build": "node build.js"
  },
  "dependencies": {
    "@toolkit/shared": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.11",
    "@types/chrome": "^0.0.268",
    "@vitest/coverage-v8": "^1.6.0",
    "esbuild": "^0.28.0",
    "jsdom": "^24.0.0",
    "typescript": "^5.4.5",
    "vitest": "^4.1.0"
  }
}
